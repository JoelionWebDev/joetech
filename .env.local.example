# Joetech — environment variables (example — copy to .env.local, never commit it)
#
# Forum sign-in (Supabase Auth). Without these two, the forum runs in
# preview mode: everyone can read, nobody can post.
# Get them from Supabase → Settings → API (or from the Vercel integration,
# which adds them automatically).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Existing keys (already in Vercel — shown here so the file is complete).
GROQ_API_KEY=
RESEND_API_KEY=
